type TokenInfo = 
 record {
   description: text;
   distribution: text;
   launchPlatform: text;
   name: text;
   slogan: text;
   socialLinks: vec record {
                      name: text;
                      url: text;
                    };
   ticker: text;
   totalSupply: text;
 };
type RoadmapMilestone = 
 record {
   completed: bool;
   date: opt text;
   description: text;
   id: text;
   title: text;
   year: text;
 };
type Result = 
 variant {
   err: text;
   ok;
 };
service : {
  adminUpdateMilestone: (id: text, completed: bool) -> (Result);
  getRoadmap: () -> (vec RoadmapMilestone) query;
  getTokenInfo: () -> (TokenInfo) query;
}
